# Copy to .env and fill in. Wrangler reads these automatically; .env is gitignored.
#
# CLOUDFLARE_ACCOUNT_ID
#   dash.cloudflare.com -> Workers & Pages -> right sidebar "Account ID"
#   (also the hex string in the dashboard URL: dash.cloudflare.com/<account-id>/...)
CLOUDFLARE_ACCOUNT_ID=

# CLOUDFLARE_API_TOKEN
#   dash.cloudflare.com/profile/api-tokens -> Create Token
#   -> use the "Edit Cloudflare Workers" template
#   -> scope Account Resources to just this account, then Continue -> Create
#   The token is shown once; copy it here immediately.
CLOUDFLARE_API_TOKEN=
