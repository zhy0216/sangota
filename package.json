{
  "name": "sangota",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "三国杀戮尖塔 — a Three Kingdoms themed roguelike deckbuilder",
  "scripts": {
    "dev": "vite",
    "dev:scene": "bun run scripts/dev-scene.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vitest run --config vitest.sim.config.ts --reporter=verbose",
    "eval": "vitest run --config vitest.eval.config.ts --reporter=verbose",
    "check": "npm run typecheck && npm test",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
